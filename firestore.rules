rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tracks/{track} {
      allow read: if true;
      allow create, update: if request.resource.data.time is number
                            && request.resource.data.time > 5
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 12;
      match /scores/{score} {
        allow read: if true;
        allow create: if request.resource.data.time is number
                      && request.resource.data.time > 5
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 12;
      }
    }
  }
}
